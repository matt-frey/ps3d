&PS3D
 field_file       = 'bolin_charney_512x512x256.nc'
 vor_visc%nnu = 3
 vor_visc%prediss = 60.0
 vor_visc%vweight = 0.01
 vor_visc%pretype = 'vortmax' !'roll-mean-max-strain'
 vor_visc%length_scale = 'Kolmogorov'
 vor_visc%roll_mean_win_size = 500
 buoy_visc%nnu = 3
 buoy_visc%prediss = 60.0
 buoy_visc%vweight = 0.01
 buoy_visc%pretype = 'vortmax' !'roll-mean-max-strain'
 buoy_visc%length_scale = 'Kolmogorov'
 buoy_visc%roll_mean_win_size = 500
 
 filter%family = 'exp'
 filter%alpha = 36.0d0 !100.d0
 filter%beta = 36.0d0 !12.0d0
 l_ensure_solenoidal = .false.

 !
 ! output info
 !
 output%field_freq     = 10.0 ! write after these many time units to the NetCDF file
 output%field_stats_freq  = 0.1  ! write after these many time units to the field stats NetCDF file
 output%write_fields    = .true.       ! enable / disable field dump
 output%write_field_stats = .true.  ! enable / disable field statistics
 output%overwrite     = .true.        ! replace existing NetCDF files
 output%basename      = 'data/bolin_charney_512x512x256_t110' ! NetCDF base name
 
 !
 ! stepper info
 !
 time%limit       = 110 ! time limit (s)
 time%alpha       = 0.1    ! scaling factor for the strain and buoyancy gradient time step
 time%precise_stop    = .false.  ! time limit exact
/
